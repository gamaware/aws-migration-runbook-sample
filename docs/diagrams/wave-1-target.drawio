        <mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="860" y="215" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1225" y="215" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="715" y="633" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="805" y="633" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="lbl-fwd" value="full load + CDC" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="585" y="635" width="125" height="24" as="geometry"/></mxCell>
        <mxCell id="lbl-rev" value="reverse CDC from C-16" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="635" width="160" height="24" as="geometry"/></mxCell>
        <mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1320" y="20" width="400" height="850" as="geometry"/></mxCell>
        <mxCell id="legend-title" value="Key" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1340" y="32" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="lg-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="66" width="34" height="32" as="geometry"/></mxCell>
        <mxCell id="lg-text-1" value="&lt;div&gt;&lt;b&gt;DNS switch&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Customers resolve shop and api through Route 53; weights are 100/0, never split (ADR 0003).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1386" y="66" width="314" height="56" as="geometry"/></mxCell>
        <mxCell id="lg-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="132" width="34" height="32" as="geometry"/></mxCell>
        <mxCell id="lg-text-2" value="&lt;div&gt;&lt;b&gt;Load balancer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Port 80 redirects to HTTPS; host rules send each name to its ECS service.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1386" y="132" width="314" height="56" as="geometry"/></mxCell>
        <mxCell id="lg-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="198" width="34" height="32" as="geometry"/></mxCell>
        <mxCell id="lg-text-3" value="&lt;div&gt;&lt;b&gt;Replatformed app&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Two Fargate tasks per service replace four servers; images pinned by digest.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1386" y="198" width="314" height="56" as="geometry"/></mxCell>
        <mxCell id="lg-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="264" width="34" height="32" as="geometry"/></mxCell>
        <mxCell id="lg-text-4" value="&lt;div&gt;&lt;b&gt;Managed database&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;RDS PostgreSQL 16, Multi-AZ, private, logical replication on for the reverse task.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1386" y="264" width="314" height="56" as="geometry"/></mxCell>
        <mxCell id="lg-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="330" width="34" height="32" as="geometry"/></mxCell>
        <mxCell id="lg-text-5" value="&lt;div&gt;&lt;b&gt;Forward replication&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;DMS full load from T-7d, then CDC until the write freeze (C-13 stops it).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1386" y="330" width="314" height="56" as="geometry"/></mxCell>
        <mxCell id="lg-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=18;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="396" width="34" height="32" as="geometry"/></mxCell>
        <mxCell id="lg-text-6" value="&lt;div&gt;&lt;b&gt;Rollback path&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Reverse CDC keeps SRV-07 current for 7 days, so R-03 keeps orders placed on AWS.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1386" y="396" width="314" height="56" as="geometry"/></mxCell>
        <mxCell id="lg-line-0" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#232F3E;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1340" y="472" as="sourcePoint"/><mxPoint x="1400" y="472" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg-line-text-0" value="Request flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1412" y="460" width="288" height="24" as="geometry"/></mxCell>
        <mxCell id="lg-line-1" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#007CBD;dashed=1;dashPattern=8 6;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1340" y="502" as="sourcePoint"/><mxPoint x="1400" y="502" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg-line-text-1" value="DNS answer (dashed: before switch or rollback)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1412" y="490" width="288" height="24" as="geometry"/></mxCell>
        <mxCell id="lg-line-2" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#01A88D;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1340" y="532" as="sourcePoint"/><mxPoint x="1400" y="532" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg-line-text-2" value="DMS replication (dashed: reverse)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1412" y="520" width="288" height="24" as="geometry"/></mxCell>
        <mxCell id="lg-line-3" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#7D8998;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1340" y="562" as="sourcePoint"/><mxPoint x="1400" y="562" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg-line-text-3" value="Hybrid link over the VPN" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1412" y="550" width="288" height="24" as="geometry"/></mxCell>
      </root>
